---
import Chaeyoung from '../assets/desain/chaeyoung.webp';
import Tzuyu from '../assets/desain/tzuyu.webp';
import Tzuyu2 from '../assets/desain/tzuyu2.webp';
import TzuyuArt from '../assets/desain/tzuyuart.webp';
import HwangYeji from '../assets/desain/hwang-yeji.webp';
import TMC1 from '../assets/desain/tmc1.webp';
import TMC2 from '../assets/desain/tmc2.webp';
import TMC3 from '../assets/desain/tmc3.webp';
import TMC4 from '../assets/desain/tmc4.webp';
import TMC5 from '../assets/desain/tmc5.webp';
import TMC6 from '../assets/desain/tmc6.webp';
import TMC7 from '../assets/desain/tmc7.webp';
import TMC8 from '../assets/desain/tmc8.webp';
import TMC9 from '../assets/desain/tmc9.webp';

const galleryItems = [
  { id: 1, title: 'Chaeyoung', category: 'Art', image: Chaeyoung },
  { id: 2, title: 'Tzuyu', category: 'Art', image: Tzuyu },
  { id: 3, title: 'Tzuyu Concept', category: 'Art', image: Tzuyu2 },
  { id: 4, title: 'Tzuyu Artwork', category: 'Art', image: TzuyuArt },
  { id: 5, title: 'Hwang Yeji', category: 'Art', image: HwangYeji },
  { id: 6, title: 'TMC #1', category: 'Design', image: TMC1 },
  { id: 7, title: 'TMC #2', category: 'Design', image: TMC2 },
  { id: 8, title: 'TMC #3', category: 'Design', image: TMC3 },
  { id: 9, title: 'TMC #4', category: 'Design', image: TMC4 },
  { id: 10, title: 'TMC #5', category: 'Design', image: TMC5 },
  { id: 11, title: 'TMC #6', category: 'Design', image: TMC6 },
  { id: 12, title: 'TMC #7', category: 'Design', image: TMC7 },
  { id: 13, title: 'TMC #8', category: 'Design', image: TMC8 },
  { id: 14, title: 'TMC #9', category: 'Design', image: TMC9 },
];
---

<div class="gallery-container">
  <div class="gallery-grid">
    {galleryItems.map(item => (
      <figure class="gallery-item">
        <img src={item.image.src} alt={item.title} loading="lazy" />
        <figcaption class="overlay">
          <h3>{item.title}</h3>
          <span class="category-tag">{item.category}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</div>

<style>
/* RESET */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* CONTAINER */
.gallery-container {
  padding: 3rem 2rem;
  min-height: 100vh;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
}

/* ✅ MASONRY GRID (AUTO HEIGHT) */
.gallery-grid {
  column-count: 4;
  column-gap: 1.25rem;
  max-width: 1500px;
  margin: 0 auto;
}

/* ITEM */
.gallery-item {
  position: relative;
  margin-bottom: 1.25rem;
  break-inside: avoid;
  border-radius: 14px;
  overflow: hidden;
  background: #111;
  box-shadow: 0 8px 24px rgba(0,0,0,.12);
  transition: transform .25s ease, box-shadow .25s ease;
}

/* IMAGE = UKURAN ASLI */
.gallery-item img {
  width: 100%;
  height: auto;
  display: block;
}

/* HOVER */
.gallery-item:hover {
  transform: translateY(-4px);
  box-shadow: 0 18px 36px rgba(0,0,0,.18);
}

/* OVERLAY */
.overlay {
  position: absolute;
  inset: 0;
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: linear-gradient(
    to top,
    rgba(0,0,0,.7),
    rgba(0,0,0,.15),
    transparent
  );
  opacity: 0;
  transition: opacity .25s ease;
}

.gallery-item:hover .overlay {
  opacity: 1;
}

/* TEXT */
.overlay h3 {
  color: #fff;
  font-size: 1.05rem;
  font-weight: 600;
  margin-bottom: .35rem;
}

.category-tag {
  font-size: .7rem;
  padding: .3rem .75rem;
  border-radius: 999px;
  color: #fff;
  background: rgba(255,255,255,.2);
  backdrop-filter: blur(6px);
  border: 1px solid rgba(255,255,255,.25);
  width: fit-content;
}

/* 📱 RESPONSIVE */
@media (max-width: 1200px) {
  .gallery-grid {
    column-count: 3;
  }
}

@media (max-width: 768px) {
  .gallery-container {
    padding: 2rem 1rem;
  }

  .gallery-grid {
    column-count: 2;
    column-gap: 1rem;
  }
}

@media (max-width: 480px) {
  .gallery-grid {
    column-count: 1;
  }
}
</style>
