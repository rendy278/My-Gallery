---

<section class="gallery-section">
  <div class="gallery-container">
    <div class="gallery-grid">
      {
        galleryItems.map((item) => (
          <figure class="gallery-item">
            <div class="image-wrapper">
              <img
                src={item.image.src}
                width={item.image.width}
                height={item.image.height}
                alt={item.title}
                loading="lazy"
                decoding="async"
                class="designwork-image"
              />

              <figcaption class="overlay">
                <div class="overlay-content">
                  <h3>{item.title}</h3>
                  <span class="category-tag">{item.category}</span>
                </div>
              </figcaption>
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  const initGalleryImages = () => {
    const images = document.querySelectorAll<HTMLImageElement>(
      ".designwork-image"
    );

    images.forEach((image) => {
      const markAsLoaded = () => {
        image.classList.add("loaded");
      };

      if (image.complete && image.naturalWidth > 0) {
        markAsLoaded();
      } else {
        image.addEventListener("load", markAsLoaded, { once: true });
      }
    });
  };

  initGalleryImages();

  document.addEventListener("astro:page-load", initGalleryImages);
</script>

<style>
  /* =========================
     GLOBAL OVERFLOW PROTECTION
  ========================= */

  :global(html) {
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
  }

  :global(body) {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: clip;
  }

  :global(*) {
    box-sizing: border-box;
  }

  /* =========================
     SECTION
  ========================= */

  .gallery-section {
    width: 100%;
    max-width: 100%;
    min-width: 0;

    overflow-x: clip;
  }

  /* =========================
     CONTAINER
  ========================= */

  .gallery-container {
    width: 100%;
    max-width: 100%;
    min-width: 0;

    margin: 0 auto;
    padding: 3rem 2rem;

    overflow-x: clip;
  }

  /* =========================
     MASONRY GRID
  ========================= */

  .gallery-grid {
    width: 100%;
    max-width: 1500px;
    min-width: 0;

    margin: 0 auto;

    column-count: 4;
    column-gap: 1.25rem;

    overflow: clip;
  }

  /* =========================
     GALLERY ITEM
  ========================= */

  .gallery-item {
    display: inline-block;

    width: 100%;
    max-width: 100%;
    min-width: 0;

    margin: 0 0 1.25rem;
    padding: 0;

    vertical-align: top;

    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    page-break-inside: avoid;
  }

  /* =========================
     IMAGE WRAPPER
  ========================= */

  .image-wrapper {
    position: relative;

    width: 100%;
    max-width: 100%;
    min-width: 0;

    overflow: hidden;

    border-radius: 14px;
    background: #111;

    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);

    isolation: isolate;

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .gallery-item:hover .image-wrapper {
    transform: translateY(-5px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.2);
  }

  /* =========================
     IMAGE LOADING EFFECT
  ========================= */

  .designwork-image {
    display: block;

    width: 100%;
    max-width: 100%;
    height: auto;

    object-fit: cover;

    filter: blur(18px);
    transform: scale(1.05);

    opacity: 0.7;

    will-change: filter, transform, opacity;

    transition:
      filter 0.7s ease,
      transform 0.7s ease,
      opacity 0.7s ease;
  }

  .designwork-image.loaded {
    filter: blur(0);
    transform: scale(1);
    opacity: 1;
  }

  /* =========================
     IMAGE HOVER
  ========================= */

  .gallery-item:hover .designwork-image.loaded {
    transform: scale(1.04);
  }

  /* =========================
     OVERLAY
  ========================= */

  .overlay {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: flex-end;

    width: 100%;
    max-width: 100%;

    padding: 1.25rem;

    opacity: 0;

    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.82) 0%,
      rgba(0, 0, 0, 0.4) 45%,
      transparent 75%
    );

    pointer-events: none;

    transition: opacity 0.3s ease;
  }

  .gallery-item:hover .overlay {
    opacity: 1;
  }

  .overlay-content {
    max-width: 100%;

    transform: translateY(12px);

    transition: transform 0.3s ease;
  }

  .gallery-item:hover .overlay-content {
    transform: translateY(0);
  }

  /* =========================
     TEXT
  ========================= */

  .overlay h3 {
    max-width: 100%;

    margin: 0 0 0.5rem;

    overflow-wrap: anywhere;

    color: #fff;

    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .category-tag {
    display: inline-flex;
    align-items: center;

    width: fit-content;
    max-width: 100%;

    padding: 0.3rem 0.75rem;

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    color: #fff;

    font-size: 0.7rem;
    font-weight: 500;

    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;

    background: rgba(255, 255, 255, 0.15);

    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* =========================
     LARGE TABLET
  ========================= */

  @media (max-width: 1200px) {
    .gallery-grid {
      column-count: 3;
    }
  }

  /* =========================
     TABLET / MOBILE
  ========================= */

  @media (max-width: 768px) {
    .gallery-container {
      padding: 2rem 1rem;
    }

    .gallery-grid {
      width: 100%;
      max-width: 100%;

      column-count: 2;
      column-gap: 1rem;
    }

    .gallery-item {
      width: 100%;
      max-width: 100%;

      margin-bottom: 1rem;
    }

    .overlay {
      padding: 1rem;
      opacity: 1;

      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.75),
        transparent 70%
      );
    }

    .overlay-content {
      transform: translateY(0);
    }

    .overlay h3 {
      font-size: 0.9rem;
    }

    .category-tag {
      font-size: 0.65rem;
    }
  }

  /* =========================
     SMALL MOBILE
  ========================= */

  @media (max-width: 480px) {
    .gallery-container {
      padding: 1.5rem 0.75rem;
    }

    .gallery-grid {
      column-count: 1;
      column-gap: 0;
    }

    .gallery-item {
      margin-bottom: 0.875rem;
    }

    .image-wrapper {
      border-radius: 12px;
    }
  }

  /* =========================
     REDUCED MOTION
  ========================= */

  @media (prefers-reduced-motion: reduce) {
    .designwork-image,
    .image-wrapper,
    .overlay,
    .overlay-content {
      transition: none;
    }

    .designwork-image {
      filter: none;
      transform: none;
      opacity: 1;
    }
  }
</style>