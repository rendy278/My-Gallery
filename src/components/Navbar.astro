<style>
/* =====================
   TEXT ANIMATION
===================== */
.skl {
  position: relative;
  display: inline-block;
  color: white;
}

.skl::before {
  content: attr(data-text);
  position: absolute;
  inset: 0;

  width: 0;
  color: #e2cf1e;
  border-right: 2px solid #e2cf1e;

  overflow: hidden;
  white-space: nowrap;

  animation: animate 5s linear infinite;
}

@keyframes animate {
