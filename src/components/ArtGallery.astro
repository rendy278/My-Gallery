---
import Ganyu from '../assets/arts/ganyu.jpg';
import SailorMoon from '../assets/arts/sailormoon.jpg';
import Shisui from '../assets/arts/shishui.jpeg';
import Violet from '../assets/arts/violet.jpeg';
import Samurai from "../assets/arts/samurai.webp"

const artworks = [
  {
    id: 1,
    title: "Ganyu",
    artist: "RenDev",
    year: "2020",
    image: Ganyu,
  },
   {
    id: 2,
    title: "Samurai",
    artist: "RenDev",
    year: "2021",
    image: Samurai,
  },
  {
    id: 3,
    title: "Sailor Moon",
    artist: "RenDev",
    year: "2023",
    image: SailorMoon,
  },
  {
    id: 4,
    title: "Shisui Uchiha",
    artist: "RenDev",
    year: "2025",
    image: Shisui,
  },
  {
    id: 5,
    title: "Violet Evergarden",
    artist: "RenDev",
    year: "2025",
    image: Violet,
  },
];
---

  <div class=" mx-auto gallery-bg ">
    <div class="gallery-carousel ">
      {artworks.map((art) => (
        <div class="gallery-slide group" >
          <div class="frame">
            <div class="frame-inner">
              <div class="canvas">
                <img
                  src={art.image.src}
                  alt={art.title}
                  loading="lazy"
                  class="artwork-image blur-load"
                  onload="this.classList.add('loaded')"
                />

                <!-- Overlay -->
                <div class="artwork-overlay">
                  <div class="overlay-content">
                    <h3 class="text-lg font-serif font-bold text-white">
                      {art.title}
                    </h3>
                    <p class="text-amber-400 text-xs font-medium">
                      {art.artist} • {art.year}
                    </p>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>


<style>
/* ================= GRID / CAROUSEL ================= */
.gallery-carousel {
  display: grid;
  gap: 1.25rem;
  padding: 2rem 1rem;
}

.gallery-bg {
  background-image: url("/wood-pattern.png");
  background-repeat: repeat;
 background-color: #b09874;
  background-size: auto;
  background-position: center;
}


@media (max-width: 767px) {
  .gallery-carousel {
    grid-template-columns: 1fr;
  }
}

@media (min-width: 768px) and (max-width: 1023px) {
  .gallery-carousel {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .gallery-carousel {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .gallery-carousel::-webkit-scrollbar {
    display: none;
  }
}

.gallery-slide {
  display: flex;
  justify-content: center;
}

@media (min-width: 1024px) {
  .gallery-slide {
    flex: 0 0 auto;
    width: 30%;
    scroll-snap-align: start;
  }
}

/* ================= FRAME ================= */
.frame {
  width: 100%;
  max-width: 340px;
  padding: 1rem;
  background: linear-gradient(135deg, #d4af37, #f4e5c3, #d4af37);
  border-radius: 4px;
  transition: transform .25s ease;
}

.group:hover .frame {
  transform: translateY(-4px);
}

.frame-inner {
  padding: .6rem;
  background: linear-gradient(135deg, #8b7355, #6b5644);
}

/* ================= CANVAS ================= */
.canvas {
  position: relative;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: #eee;
}

/* ================= BLUR LOADING IMAGE ================= */
.artwork-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: 
    filter .5s ease,
    transform .5s ease;
}

/* sebelum load */
.blur-load {
  filter: blur(18px);
  transform: scale(1.08);
}

/* setelah load */
.blur-load.loaded {
  filter: blur(0);
  transform: scale(1);
}

.group:hover .artwork-image {
  transform: scale(1.04);
}

/* ================= OVERLAY ================= */
.artwork-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(0,0,0,.85),
    rgba(0,0,0,.45),
    transparent
  );
  opacity: 0;
  transition: opacity .3s ease;
  display: flex;
  align-items: flex-end;
  padding: 1rem;
}

.group:hover .artwork-overlay {
  opacity: 1;
}

.overlay-content {
  transform: translateY(10px);
  transition: transform .3s ease;
}

.group:hover .overlay-content {
  transform: translateY(0);
}
</style>
